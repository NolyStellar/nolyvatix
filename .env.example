# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Platform Metadata
VITE_APP_TITLE="Nolyvatix - Stellar Blockchain BI Platform"
VITE_STELLAR_NETWORK="mainnet"

# Blockchain RPC & REST Nodes
VITE_HORIZON_URL="https://horizon.stellar.org"
VITE_SOROBAN_RPC_URL="https://mainnet.sorobanrpc.com"

# Features & Feature Flags
VITE_ENABLE_MOCK_DATA="true"
VITE_ENABLE_AI_COPILOT="true"

# Development Auth Fallback (Set to "true" to enable local operator mode when Firebase Auth is omitted)
ALLOW_DEV_FALLBACK="true"

# Production Security & CORS Configuration (SEC-02)
# Comma-separated list of allowed browser origins for cross-origin API requests.
# Supports exact origin URLs (e.g. https://nolyvatix.io) and wildcard subdomains (e.g. https://*.run.app).
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting Configuration (SEC-02)
# Set to "false" to disable rate limiting (e.g., during stress testing or CI)
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_GLOBAL_MAX="300"
RATE_LIMIT_GLOBAL_WINDOW_MS="60000"
RATE_LIMIT_AI_MAX="30"
RATE_LIMIT_SOROBAN_MAX="120"
RATE_LIMIT_SEARCH_MAX="60"

# Optional Cloud SQL / PostgreSQL Persistence (Drizzle ORM)
# If omitted or unconfigured, Nolyvatix seamlessly uses built-in in-memory repository storage.
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
